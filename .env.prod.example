# ==============================================================================
# 🏢 IRM (Incoming Raw Material) — Production Environment Configuration
# Target Domain: https://irm.windowasia.com
# ==============================================================================

# ─── Application URLs ─────────────────────────────────────────────────────────
APP_ENV=production
APP_BASE_URL=https://irm.windowasia.com
FRONTEND_URL=https://irm.windowasia.com
BACKEND_URL=https://irm.windowasia.com/api
NEXT_PUBLIC_API_URL=https://irm.windowasia.com/api

# ─── Web Gateway Port ─────────────────────────────────────────────────────────
# Change this port if 8088 is occupied on your Hostinger VPS.
# Host Nginx / Nginx Proxy Manager will reverse proxy https://irm.windowasia.com -> http://127.0.0.1:8088
IRM_HTTP_PORT=8088

# ─── Database Credentials (PostgreSQL 16) ────────────────────────────────────
DB_NAME=irm_db
DB_USER=irm_admin
DB_PASSWORD=ChangeThisToStrongPassword2026!

# ─── Security Secrets ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=e83a9f029b4c12e87d65b1a03f49c5e2197305d8f64e28b17a59c03de421fa89
